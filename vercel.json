{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.standardroofingcompany.net"
        }
      ],
      "destination": "https://standardroofingcompany.net/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/specialty-roofing.html",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/storm-damage.html",
      "destination": "/services/storm-damage-roofing",
      "permanent": true
    },
    {
      "source": "/metal-roofing.html",
      "destination": "/services/metal-roofing",
      "permanent": true
    },
    {
      "source": "/slate-roofing.html",
      "destination": "/services/slate-roofing",
      "permanent": true
    },
    {
      "source": "/tile-roofing.html",
      "destination": "/services/tile-roofing",
      "permanent": true
    },
    {
      "source": "/cedar-shake-roofing.html",
      "destination": "/services/cedar-shake-roofing",
      "permanent": true
    },
    {
      "source": "/synthetic-roofing.html",
      "destination": "/services/synthetic-roofing",
      "permanent": true
    },
    {
      "source": "/roof-coatings.html",
      "destination": "/services/roof-coatings",
      "permanent": true
    },
    {
      "source": "/service-areas.html",
      "destination": "/service-areas",
      "permanent": true
    },
    {
      "source": "/mountain-roofing.html",
      "destination": "/service-areas",
      "permanent": true
    },
    {
      "source": "/roofing-:city-co.html",
      "destination": "/roofing/:city",
      "permanent": true
    },
    {
      "source": "/casualty.html",
      "destination": "/casualty",
      "permanent": true
    },
    {
      "source": "/roofing-expert-witness-colorado.html",
      "destination": "/casualty/litigation-support",
      "permanent": true
    },
    {
      "source": "/hail-damage-cause-of-loss-inspection.html",
      "destination": "/casualty/hail-damage-documentation",
      "permanent": true
    },
    {
      "source": "/roofing-construction-defect-review.html",
      "destination": "/casualty/construction-defect-review",
      "permanent": true
    },
    {
      "source": "/roofing-fall-protection-standard-of-care.html",
      "destination": "/casualty/fall-protection-standard-of-care",
      "permanent": true
    },
    {
      "source": "/roof-repair-cost-estimates-insurance-appraisal.html",
      "destination": "/casualty/appraisal-and-umpire-support",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/specialty-roofing",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/storm-damage",
      "destination": "/services/storm-damage-roofing",
      "permanent": true
    },
    {
      "source": "/metal-roofing",
      "destination": "/services/metal-roofing",
      "permanent": true
    },
    {
      "source": "/slate-roofing",
      "destination": "/services/slate-roofing",
      "permanent": true
    },
    {
      "source": "/tile-roofing",
      "destination": "/services/tile-roofing",
      "permanent": true
    },
    {
      "source": "/cedar-shake-roofing",
      "destination": "/services/cedar-shake-roofing",
      "permanent": true
    },
    {
      "source": "/synthetic-roofing",
      "destination": "/services/synthetic-roofing",
      "permanent": true
    },
    {
      "source": "/roof-coatings",
      "destination": "/services/roof-coatings",
      "permanent": true
    },
    {
      "source": "/mountain-roofing",
      "destination": "/service-areas",
      "permanent": true
    },
    {
      "source": "/roofing-:city-co",
      "destination": "/roofing/:city",
      "permanent": true
    },
    {
      "source": "/roofing-expert-witness-colorado",
      "destination": "/casualty/litigation-support",
      "permanent": true
    },
    {
      "source": "/hail-damage-cause-of-loss-inspection",
      "destination": "/casualty/hail-damage-documentation",
      "permanent": true
    },
    {
      "source": "/roofing-construction-defect-review",
      "destination": "/casualty/construction-defect-review",
      "permanent": true
    },
    {
      "source": "/roofing-fall-protection-standard-of-care",
      "destination": "/casualty/fall-protection-standard-of-care",
      "permanent": true
    },
    {
      "source": "/roof-repair-cost-estimates-insurance-appraisal",
      "destination": "/casualty/appraisal-and-umpire-support",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(main|analytics).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}